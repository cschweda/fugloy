{
  "name": "fugloy",
  "private": true,
  "version": "1.2.0",
  "description": "TRS-80 Model I/III disassembler: Z80 tables, .CMD/.BAS loaders, CLI",
  "license": "MIT",
  "type": "module",
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b packages/z80 packages/disasm packages/asm packages/cli && tsc -p tsconfig.test.json",
    "build": "tsc -b packages/z80 packages/disasm packages/asm packages/cli",
    "clean": "rm -rf packages/*/dist",
    "fixtures": "tsx packages/disasm/scripts/write-fixtures.ts && node packages/emu/scripts/write-label-fixture.mjs && node packages/emu/scripts/write-disk-fixtures.mjs && node packages/emu/scripts/write-model3-state-fixture.mjs",
    "symbols": "tsx packages/disasm/scripts/write-symbols.ts",
    "test:web": "pnpm --filter @fugloy/web test",
    "web:dev": "pnpm --filter @fugloy/web dev",
    "web:generate": "pnpm --filter @fugloy/web generate",
    "fugloy": "node packages/cli/bin/fugloy.js",
    "zmac:install": "bash scripts/install-zmac.sh",
    "asm:corpus": "pnpm build && node packages/asm/scripts/corpus.mjs",
    "zex:install": "bash scripts/install-zex.sh",
    "trsjs:install": "bash scripts/install-trsjs.sh",
    "diff": "node packages/emu/scripts/diff.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.0.4"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
