# Copyrighted sample programs and ROM images stay out of the repo (public-domain
# programs are committed under examples/). Tests that need them skip when absent.
fixtures/real/
sample/
*.rom
*.ROM
packages/emu/roms/
# Copyrighted manuals and books the symbol tables cite (phase 3); each table entry names its page.
docs/reference/
# Local ROM paths for the emulator and the MCP server (fugloy.mcp.example.json shows the format).
fugloy.mcp.json
# Sidecar label files the MCP server writes beside a program (packages/mcp/prompts/*.md load the
# committed examples, so a session would otherwise leave one in examples/).
examples/**/*.fugloy.json
# Your Claude Code MCP config, copied from .mcp.json.example (a committed one would start the server for everyone).
/.mcp.json

# Dependencies and build output
node_modules/
dist/
.output/
.nuxt/
.cache/
*.tsbuildinfo

# Netlify
.netlify/

# Environment and local overrides
.env
.env.*
!.env.example

# Editor and OS noise
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json
!.vscode/extensions.json

# Test and coverage artifacts
coverage/
playwright-report/
test-results/

# Claude Code local settings (keep CLAUDE.md; ignore per-machine state)
.claude/settings.local.json

# Plan execution scratch (superpowers)
.superpowers/

# Pinned zmac built by scripts/install-zmac.sh
/tools/

# Web workbench (phase 4): Nuxt output and the examples copied in by prepare-assets
apps/web/.nuxt
apps/web/.output
apps/web/public/examples
apps/web/public/og-image.png
apps/web/dist

# Tarballs staged by ./publish.sh check
.release/
