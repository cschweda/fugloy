; Build Space Invaders, chapter 11: bombs, and lives. Chapter 10's game,
; and now the invaders bomb the base. MOVEBOMB drops a bomb from an invader
; that LD A,R picks, one bomb at a time, and moves it down a row a turn. A
; bomb that falls into the base costs a life, and with none left the game
; is over: GAME OVER, and the program stops.

        ORG     7000H           ; the program lives at 7000H, in free memory

; WAIT: a counted delay, 5,120 passes of 26 T-states, about 66 ms a turn at
; 2.03 MHz. The routines come first, and the game itself after them, from
; START, where END START says the program begins.
WAIT:   PUSH    BC              ; save BC, which the loop uses
        LD      BC,1400H        ; 1400H is 5,120 passes of 26 T-states
DELAY:  DEC     BC
        LD      A,B
        OR      C
        JR      NZ,DELAY
        POP     BC              ; BC as the caller left it
        RET

; DRAWBASE: copy the three bytes HL points at to the base's place on row 15,
; 3FC0H plus BASEX. BC is kept on the stack; A, DE and HL are not.
DRAWBASE:
        PUSH    BC              ; save BC, which LDIR counts down
        LD      A,(BASEX)       ; the base's column ...
        ADD     A,0C0H          ; ... plus 3FC0H, row 15: the base's left cell
        LD      E,A
        LD      D,3FH
        LD      BC,3            ; three bytes
        LDIR                    ; from (HL) to (DE), one byte at a time
        POP     BC              ; BC as the caller left it
        RET

; MOVEBASE: with the left or right arrow down, erase the base, move it a
; column, and draw it again. Columns 0 and 61 are the edges: there it stays.
MOVEBASE:
        LD      A,(3840H)       ; the arrows' row: bit 5 left, 6 right
        AND     60H             ; keep those two bits (0110 0000)
        RET     Z               ; neither is down: nothing to do
        LD      C,A             ; keep the keys in C, so A is free
        LD      HL,BLANK        ; erase the base where it is
        CALL    DRAWBASE
        LD      A,(BASEX)       ; the base's column, from memory
        BIT     5,C             ; left?
        JR      Z,NOTLT
        CP      0               ; column 0, the left edge: stay
        JR      Z,NOTLT
        DEC     A
NOTLT:
        BIT     6,C             ; right?
        JR      Z,NOTRT
        CP      61              ; column 61, the right edge for three cells: stay
        JR      Z,NOTRT
        INC     A
NOTRT:
        LD      (BASEX),A       ; the new column, back to memory
        LD      HL,BASE         ; draw the base there
        CALL    DRAWBASE
        RET

; MOVESHOT: the shot, if there is one, moves up a row; past row 0 it is gone,
; and moving into an invader it shoots it down, and is gone too.
MOVESHOT:
        LD      HL,(SHOT)       ; where the shot is: two bytes from memory into HL
        LD      A,H             ; 0 is no shot: test HL as the clear tests BC
        OR      L
        RET     Z               ; no shot: nothing to do
        LD      (HL),20H        ; erase the shot where it is
        LD      DE,-64          ; up a row
        ADD     HL,DE
        BIT     2,H             ; still on the screen? 3C00H-3FFFH all have bit 2 of H set
        JR      NZ,SHOTUP
        LD      HL,0            ; off the top: no shot
SHOTUP: LD      (SHOT),HL       ; keep where it is, or 0
        LD      A,H
        OR      L
        RET     Z               ; gone: nothing to draw
        LD      A,(HL)          ; what is in the cell the shot moves into?
        CP      9EH             ; an invader's left cell: HL is its address
        JR      Z,HIT
        CP      0ADH            ; its right cell: its address is one before
        JR      Z,HITRT
        LD      (HL),21H        ; the shot is an exclamation mark
        RET
HITRT:  DEC     HL              ; back to the invader's left cell
HIT:    LD      (HL),20H        ; erase the invader's two cells
        INC     HL
        LD      (HL),20H
        DEC     HL              ; HL is the invader's address again
        CALL    KILL            ; its place in the table becomes 0
        CALL    ADDSCORE        ; 10 points
        LD      HL,0            ; and the shot is gone too
        LD      (SHOT),HL
        RET

; FIRE: with the space bar down and no shot in the air, a shot starts on
; row 14, just above the base's middle cell.
FIRE:   LD      A,(3840H)       ; the space bar is bit 7 of the arrows' row
        BIT     7,A
        RET     Z               ; not down: nothing to do
        LD      HL,(SHOT)
        LD      A,H
        OR      L
        RET     NZ              ; a shot is in the air already: one at a time
        LD      A,(BASEX)       ; row 14 starts at 3F80H; the base's middle
        ADD     A,81H           ; is its column plus one: 3F81H plus BASEX
        LD      L,A
        LD      H,3FH
        LD      (HL),21H        ; draw the shot
        LD      (SHOT),HL       ; and remember where it is
        RET

; DRAWROW: copy the two bytes DE points at to every invader's place: INVS
; holds their screen addresses, a word each. IX walks the table and B counts
; the invaders; BC is kept on the stack, and DE ends where it began.
DRAWROW:
        PUSH    BC              ; save BC: B counts the invaders
        LD      IX,INVS         ; IX points at the table's first word
        LD      B,NINV          ; NINV invaders, counted down by DJNZ
DRAWONE:
        LD      L,(IX+0)        ; this invader's screen address: the low byte
        LD      H,(IX+1)        ; first, then the high, as a DW stores them
        LD      A,H             ; 0 is an invader shot down: nothing to draw
        OR      L
        JR      Z,DRAWNEXT
        LD      A,(DE)          ; the shape's left cell
        LD      (HL),A
        INC     HL
        INC     DE
        LD      A,(DE)          ; and its right cell
        LD      (HL),A
        DEC     DE              ; back to the shape's start, for the next one
DRAWNEXT:
        INC     IX              ; on to the next word of the table
        INC     IX
        DJNZ    DRAWONE         ; B minus 1, and the next invader until it is 0
        POP     BC              ; BC as the caller left it
        RET

; MARCH: every fourth turn, erase the row and move it a column, the way STEP
; says. At the edge the row is marching to, it turns round, and that step
; goes down a row instead, until the lowest row is on row 13.
MARCH:  LD      HL,TICK         ; one turn fewer to the row's next step
        DEC     (HL)
        RET     NZ              ; not 0 yet: not this turn
        LD      (HL),4          ; 0: a step now, and the next in four turns
        LD      DE,BLANK        ; erase the row where it is
        CALL    DRAWROW
        LD      DE,(STEP)       ; the step: 1 right, or -1 left
        CALL    EDGE            ; Z: an invader is at the edge ahead
        JR      NZ,SIDE
        LD      HL,0            ; turn round: the step becomes 0 minus the step
        OR      A               ; clear the carry flag, which SBC takes off too
        SBC     HL,DE
        LD      (STEP),HL
        EX      DE,HL           ; and the new step into DE
        LD      A,(INVROW)      ; the top row's row: the lowest is 4 below
        CP      9               ; row 9, so the lowest is on row 13?
        JR      Z,SIDE          ; then they only turn, and step sideways
        INC     A               ; one row lower
        LD      (INVROW),A
        LD      DE,64           ; a row is 64 cells: this step goes down
SIDE:   CALL    MOVEROW         ; every invader moves by DE
        RET

; EDGE: is an invader at the edge the row is marching to? E is the step's
; low byte, 1 or 0FFH. The low six bits of an invader's address are its
; column; the next column would be 63 at the right edge, and -1 at the left,
; and both are 3FH in six bits. Z if an invader is there, NZ if none is.
EDGE:   LD      IX,INVS         ; IX walks the table, as in DRAWROW
        LD      B,NINV
EDGEONE:
        LD      A,(IX+1)        ; 0 is an invader shot down: skip it
        OR      (IX+0)
        JR      Z,EDGENEXT
        LD      A,(IX+0)        ; the low byte of the invader's address
        ADD     A,E             ; plus the step
        AND     3FH             ; its low six bits: the column it would move to
        CP      3FH             ; 63, or -1: past an edge
        RET     Z               ; this one is at the edge: return with Z
EDGENEXT:
        INC     IX
        INC     IX
        DJNZ    EDGEONE
        OR      1               ; none is: A is not 0 after OR 1, so NZ
        RET

; MOVEROW: add DE to every invader's address in INVS: 1 moves the row a
; column right, -1, the word 0FFFFH, a column left, and 64 a row down.
MOVEROW:
        LD      IX,INVS
        LD      B,NINV
MOVEONE:
        LD      L,(IX+0)        ; the invader's address into HL
        LD      H,(IX+1)
        LD      A,H             ; 0 is an invader shot down: it stays 0
        OR      L
        JR      Z,MOVENEXT
        ADD     HL,DE           ; plus the step
        LD      (IX+0),L        ; and back into the table
        LD      (IX+1),H
MOVENEXT:
        INC     IX
        INC     IX
        DJNZ    MOVEONE
        RET

; KILL: the invader at screen address HL is shot down: its place in INVS
; becomes 0, which DRAWROW, EDGE and MOVEROW skip.
KILL:   LD      IX,INVS
        LD      B,NINV
KILLONE:
        LD      A,(IX+0)        ; this place's low byte: HL's?
        CP      L
        JR      NZ,KILLNEXT
        LD      A,(IX+1)        ; and its high byte: HL's too?
        CP      H
        JR      NZ,KILLNEXT
        LD      (IX+0),0        ; this is the invader: its place becomes 0
        LD      (IX+1),0
        RET
KILLNEXT:
        INC     IX
        INC     IX
        DJNZ    KILLONE
        RET

; ADDSCORE: 10 points more. SCORE is two bytes of BCD, two decimal digits in
; each, four bits a digit: the low byte holds the last two digits. DAA after
; each add puts the digits right, and its carry goes on to the high byte.
ADDSCORE:
        LD      HL,SCORE        ; the last two digits
        LD      A,(HL)
        ADD     A,10H           ; plus 10: a 1 in the tens digit
        DAA                     ; back to two decimal digits, carry past 99
        LD      (HL),A
        INC     HL              ; the first two digits (LD and INC HL keep C)
        LD      A,(HL)
        ADC     A,0             ; plus the carry from the last two
        DAA
        LD      (HL),A
        RET

; SHOWSCORE: print the lives at the end of row 0, and SCORE and its four
; digits at the start. It runs every turn, so where a shot passes through
; the top line, it is mended at once.
SHOWSCORE:
        LD      HL,LIVESTXT     ; the lives' word
        LD      DE,3C39H        ; to row 0, column 57
        LD      BC,6
        LDIR                    ; DE ends on column 63, the row's last
        LD      A,(LIVES)       ; the lives, 0 to 3: one digit
        ADD     A,'0'
        LD      (DE),A
        LD      HL,SCORETXT     ; the word, from the table
        LD      DE,3C00H        ; to row 0, column 0
        LD      BC,6
        LDIR                    ; DE ends on column 6, where the digits go
        LD      HL,SCORE+1      ; the first two digits, in the high byte
        CALL    TWODIG
        DEC     HL              ; then the last two, in the low byte, and
                                ; TWODIG's RET returns from SHOWSCORE
; TWODIG: print the two digits of the byte HL points at, at DE, and move DE on.
TWODIG: LD      A,(HL)          ; the byte: two digits
        RRCA                    ; four rotates bring its high digit down
        RRCA                    ; to the low four bits
        RRCA
        RRCA
        AND     0FH             ; just that digit, 0 to 9
        ADD     A,'0'           ; its character: '0' is 30H, '9' is 39H
        LD      (DE),A
        INC     DE
        LD      A,(HL)          ; the byte again, for its low digit
        AND     0FH
        ADD     A,'0'
        LD      (DE),A
        INC     DE
        RET

; MOVEBOMB: the bomb, if there is one, falls a row. It is erased only if it
; is still what is in its cell, and drawn only in a blank cell: anything else
; there, an invader or the shot, it passes behind. Falling into the base, it
; costs a life. With no bomb, DROP drops one.
MOVEBOMB:
        LD      HL,(BOMB)       ; where the bomb is, or 0 for none
        LD      A,H
        OR      L
        JR      Z,DROP          ; no bomb: drop one
        LD      A,(HL)          ; is the bomb still what is in its cell?
        CP      BOMBCH
        JR      NZ,FALL         ; no: something was drawn over it, leave that
        LD      (HL),20H        ; yes: erase it
FALL:   LD      DE,64           ; down a row
        ADD     HL,DE
        BIT     2,H             ; still on the screen, as for the shot?
        JR      NZ,BOMBON
        LD      HL,0            ; off the bottom: no bomb
BOMBON: LD      (BOMB),HL       ; keep where it is, or 0
        LD      A,H
        OR      L
        RET     Z               ; gone: nothing to draw
        LD      A,(HL)          ; what is in the cell the bomb falls into?
        CP      20H             ; a blank: draw the bomb there
        JR      Z,BOMBDRAW
        CP      0BCH            ; the base's wing
        JR      Z,BASEHIT
        CP      0BFH            ; or its middle
        JR      Z,BASEHIT
        RET                     ; anything else: the bomb passes behind it
BOMBDRAW:
        LD      (HL),BOMBCH
        RET                     ; the bomb is in its new cell
BASEHIT:
        LD      HL,0            ; the bomb is gone
        LD      (BOMB),HL
        LD      HL,LIVES        ; and a life
        DEC     (HL)
        RET     NZ              ; lives left: play on
        JP      OVER            ; none: the game is over
; DROP: pick an invader with the R register, and drop a bomb from the cell
; under its left cell. If the invader is shot down, no bomb this turn.
DROP:   LD      A,R             ; R counts instruction fetches: 0 to 127 here
WHICH:  CP      NINV            ; the remainder by NINV: carry when A is less
        JR      C,PICKED
        SUB     NINV            ; otherwise take NINV away and compare again
        JR      WHICH
PICKED: ADD     A,A             ; times 2: a word a place
        LD      E,A
        LD      D,0
        LD      IX,INVS
        ADD     IX,DE           ; IX points at the invader's place
        LD      L,(IX+0)
        LD      H,(IX+1)
        LD      A,H             ; 0 is shot down: no bomb
        OR      L
        RET     Z
        JR      FALL            ; the bomb starts a row below the invader

START:  LD      HL,3C00H        ; HL points at the top-left cell
        LD      BC,400H         ; BC counts the cells: 400H is 1024
CLEAR:  LD      (HL),20H        ; a space: the cell is blank
        INC     HL              ; on to the next cell
        DEC     BC              ; one cell fewer to go (DEC BC sets no flags ...)
        LD      A,B             ; ... so test BC by hand: copy B into A
        OR      C               ; and OR in C: zero only when B and C both are
        JR      NZ,CLEAR        ; not zero yet: clear the next cell
        LD      HL,BASE         ; draw the base where BASEX says
        CALL    DRAWBASE

; The game loop: one turn of the game, then round again. A game's turn
; reads the keys, moves things and draws them: the base, the shot, the invaders.
LOOP:   CALL    WAIT            ; the turn's pause, so the game runs at a steady speed
        CALL    MOVEBASE        ; the base moves if an arrow is down
        CALL    MOVESHOT        ; the shot, if there is one, rises a row
        CALL    FIRE            ; the space bar starts a shot, if there is none
        CALL    MARCH           ; every fourth turn, the row steps
        LD      DE,INVADER      ; the row, drawn every turn: a shot passing
        CALL    DRAWROW         ; through an invader erases a cell, and this mends it
        CALL    MOVEBOMB        ; the bomb falls, or a new one drops
        CALL    SHOWSCORE       ; the score, on row 0
        JR      LOOP            ; and round again, until the game is over

; OVER: no lives left. The top line once more, to show LIVES 0, then the
; words, and the program stops here: Run starts a new game.
OVER:   CALL    SHOWSCORE
        LD      HL,OVERTXT      ; GAME OVER
        LD      DE,3C1BH        ; to row 0, column 27, between the two
        LD      BC,9
        LDIR
STOP:   JR      STOP            ; the game is over: wait here for good
; The game's data: below the loop, where the processor never runs into it.
BASE:   DB      0BCH,0BFH,0BCH  ; the base: a wing, a block, a wing
BLANK:  DB      '   '           ; three spaces, to erase it
INVADER:
        DB      9EH,0ADH        ; an invader: two cells, a head, arms and legs
; INVS: the invaders' places, a row's start plus a column, rows 2, 4 and 6;
; 0 is shot down. NINV is how many: EQU names a number, and takes no memory.
NINV:   EQU     24
INVS:   DW      3C80H+14,3C80H+18,3C80H+22,3C80H+26
        DW      3C80H+30,3C80H+34,3C80H+38,3C80H+42
        DW      3D00H+14,3D00H+18,3D00H+22,3D00H+26
        DW      3D00H+30,3D00H+34,3D00H+38,3D00H+42
        DW      3D80H+14,3D80H+18,3D80H+22,3D80H+26
        DW      3D80H+30,3D80H+34,3D80H+38,3D80H+42
BASEX:  DB      30              ; the base's column, 0 to 61
SHOT:   DW      0               ; the shot's screen address, or 0 for none
STEP:   DW      1               ; the row's step: 1 right, or -1 (0FFFFH) left
TICK:   DB      4               ; turns to the row's next step
INVROW: DB      2               ; the top row's row, 2 to 9
SCORETXT:
        DB      'SCORE '        ; the score's word, and a space
SCORE:  DB      0,0             ; in BCD: the last two digits, then the first two
LIVESTXT:
        DB      'LIVES '        ; the lives' word, and a space
LIVES:  DB      3               ; lives left
BOMBCH: EQU     99H             ; the bomb: a zigzag, three blocks
BOMB:   DW      0               ; the bomb's screen address, or 0 for none
OVERTXT:
        DB      'GAME OVER'

        END     START           ; the program starts at START
