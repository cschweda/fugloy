; Invaders march: lesson 6's ship and shot, and above them a row of six
; invaders on row 2 that steps a cell at a time to the right, and at the
; screen's edge turns and steps back to the left. The row's state is a small
; table, ROW, read through IX with an offset: its left column, its step (1
; right, -1 left), and how many invaders it has. Each invader is two cells
; drawn from SHAPE, four cells apart, and DJNZ counts them. The game loop is
; lesson 6's, with DJNZ counting four turns to each march step. The shot
; passes through the invaders: hitting them comes later.

        ORG     7000H           ; the program lives at 7000H, as in lessons 1 to 6

START:  LD      IX,ROW          ; IX points at the row's table, for good
        LD      HL,SHAPE        ; draw the row where it starts
        CALL    DRAWROW
        LD      HL,SHIP         ; and the ship where SHIPX says
        CALL    SHOW

LOOP:   LD      B,4             ; four turns to each march step
PLAY:   CALL    WAIT            ; lesson 6's turn: no routine in it changes B
        CALL    MOVESHIP        ; the ship moves if an arrow is down
        CALL    MOVESHOT        ; the shot, if there is one, rises a row
        CALL    FIRE            ; the space bar starts a shot, if there is none
        DJNZ    PLAY            ; B minus 1, and another turn until it is 0
        CALL    MARCH           ; then the invaders step
        JR      LOOP

; MARCH: erase the row, move it one cell, turn it at an edge, draw it.
MARCH:  LD      HL,BLANK        ; erase the row where it is
        CALL    DRAWROW
        LD      A,(IX+0)        ; the row's left column
        ADD     A,(IX+1)        ; plus its step: 1, or 0FFH, which is -1
        LD      (IX+0),A        ; is its new column
        LD      C,A             ; keep it in C
        CP      0               ; at the left edge?
        JR      Z,TURN
        LD      A,(IX+2)        ; how many invaders: the row is 4 cells each,
        ADD     A,A             ; less the last one's gap of two, so its last
        ADD     A,A             ; left column is 64 - (4n - 2) = 66 - 4n
        LD      B,A
        LD      A,66
        SUB     B
        CP      C               ; at the right edge?
        JR      NZ,DRAW
TURN:   LD      A,(IX+1)        ; turn round: the step changes sign,
        NEG                     ; 1 to -1 or -1 to 1
        LD      (IX+1),A
DRAW:   LD      HL,SHAPE        ; draw the row where it is now
        CALL    DRAWROW
        RET

; DRAWROW: draw the row's invaders on row 2 (3C80H), each from the two bytes
; HL points at, four cells apart. HL and DE are kept on the stack, as
; lesson 5's SHOW kept BC and DE.
DRAWROW:
        PUSH    HL
        PUSH    DE
        LD      A,(IX+0)        ; the row's left column, plus 3C80H, row 2:
        ADD     A,80H           ; the first invader's left cell
        LD      E,A
        LD      D,3CH
        LD      B,(IX+2)        ; B counts the invaders for DJNZ
NEXT:   LD      A,(HL)          ; the shape's left cell
        LD      (DE),A
        INC     HL
        INC     DE
        LD      A,(HL)          ; and its right cell
        LD      (DE),A
        DEC     HL              ; back to the shape's start for the next one
        INC     DE              ; on past the gap of two:
        INC     DE              ; invaders are four cells apart
        INC     DE
        DJNZ    NEXT            ; the next invader, until B is 0
        POP     DE
        POP     HL
        RET

; MOVESHIP: lesson 5's move, with the ship's column kept in SHIPX.
MOVESHIP:
        LD      A,(3840H)       ; the arrows' row: bit 5 left, 6 right
        AND     60H             ; keep those two bits (0110 0000)
        RET     Z               ; neither is down: nothing to do
        LD      C,A             ; keep the keys in C, so A is free
        LD      HL,BLANK        ; erase the ship where it is
        CALL    SHOW
        LD      A,(SHIPX)       ; the ship's column, from memory
        BIT     5,C             ; left?
        JR      Z,NOTLT
        CP      0               ; column 0, the left edge: stay
        JR      Z,NOTLT
        DEC     A
NOTLT:
        BIT     6,C             ; right?
        JR      Z,NOTRT
        CP      61              ; column 61, the right edge for three cells: stay
        JR      Z,NOTRT
        INC     A
NOTRT:
        LD      (SHIPX),A       ; the new column, back to memory
        LD      HL,SHIP         ; draw the ship there
        CALL    SHOW
        RET

; MOVESHOT: the shot, if there is one, moves up a row; past row 0 it is gone.
MOVESHOT:
        LD      HL,(SHOT)       ; where the shot is: two bytes from memory into HL
        LD      A,H             ; 0 is no shot: test HL as lesson 1 tested BC
        OR      L
        RET     Z               ; no shot: nothing to do
        LD      (HL),20H        ; erase the shot where it is
        LD      DE,-64          ; up a row
        ADD     HL,DE
        BIT     2,H             ; still on the screen? (lesson 3)
        JR      NZ,SHOTUP
        LD      HL,0            ; off the top: no shot
SHOTUP: LD      (SHOT),HL       ; keep where it is, or 0
        LD      A,H
        OR      L
        RET     Z               ; gone: nothing to draw
        LD      (HL),21H        ; the shot is an exclamation mark
        RET

; FIRE: with the space bar down and no shot in the air, a shot starts on
; row 14, just above the ship's middle cell.
FIRE:   LD      A,(3840H)       ; the space bar is bit 7 of the same row
        BIT     7,A
        RET     Z               ; not down: nothing to do
        LD      HL,(SHOT)
        LD      A,H
        OR      L
        RET     NZ              ; a shot is in the air already: one at a time
        LD      A,(SHIPX)       ; row 14 starts at 3F80H; the ship's middle
        ADD     A,81H           ; is its column plus one: 3F81H plus SHIPX
        LD      L,A
        LD      H,3FH
        LD      (HL),21H        ; draw the shot
        LD      (SHOT),HL       ; and remember where it is
        RET

; SHOW: copy the three bytes HL points at to the ship's place on row 15,
; 3FC0H plus SHIPX. BC is kept on the stack, as in lesson 5.
SHOW:   PUSH    BC              ; save BC: the keys are in C
        LD      A,(SHIPX)       ; the ship's column ...
        ADD     A,0C0H          ; ... plus 3FC0H, row 15: the ship's left cell
        LD      E,A
        LD      D,3FH
        LD      BC,3            ; three bytes
        LDIR                    ; from (HL) to (DE), as in lesson 4
        POP     BC
        RET

; WAIT: lesson 5's delay, 133,120 T-states, about 66 ms at 2.03 MHz.
WAIT:   PUSH    BC              ; save BC, which the loop uses
        LD      BC,1400H        ; 1400H is 5,120 passes of 26 T-states
DELAY:  DEC     BC
        LD      A,B
        OR      C
        JR      NZ,DELAY
        POP     BC              ; BC as the caller left it
        RET

SHIP:   DB      0BCH,0BFH,0BCH  ; the ship: a wing, a block, a wing
BLANK:  DB      '   '           ; three spaces, to erase it

SHIPX:  DB      30              ; the ship's column, 0 to 61
SHOT:   DW      0               ; the shot's screen address, or 0 for none

SHAPE:  DB      9EH,0ADH        ; an invader: two cells, a head, arms and legs
                                ; (erased with the first two spaces of BLANK)

ROW:    DB      8               ; IX+0: the row's left column
        DB      1               ; IX+1: its step, 1 right or -1 (0FFH) left
        DB      6               ; IX+2: how many invaders

        END     START           ; the program starts at START
