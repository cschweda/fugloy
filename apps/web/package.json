{
  "name": "@fugloy/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "postinstall": "nuxt prepare",
    "prepare-assets": "tsx scripts/prepare-assets.ts",
    "predev": "pnpm run prepare-assets",
    "dev": "nuxt dev",
    "pregenerate": "pnpm run prepare-assets",
    "generate": "nuxt generate",
    "typecheck": "nuxt prepare && nuxt typecheck && tsc -p tsconfig.test.json",
    "pretest": "nuxt prepare && pnpm run prepare-assets",
    "test": "vitest run",
    "test:seo": "pnpm run generate && FUGLOY_REQUIRE_SEO=1 vitest run test/seo.test.ts",
    "test:e2e": "playwright test",
    "render-brand": "tsx scripts/render-brand.ts",
    "outline-card-text": "tsx scripts/outline-card-text.ts"
  },
  "dependencies": {
    "@fugloy/disasm": "workspace:*",
    "@fugloy/z80": "workspace:*",
    "@nuxt/ui": "^4.12.0",
    "nuxt": "^4.6.2",
    "pdfjs-dist": "~6.4.299",
    "tailwindcss": "^4.0.0",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@fontsource/jetbrains-mono": "^5.3.0",
    "@fugloy/cli": "workspace:*",
    "@fugloy/emu": "workspace:*",
    "@nuxt/test-utils": "^4.3.4",
    "@playwright/test": "~1.64.1",
    "@types/node": "^22.20.5",
    "@types/opentype.js": "^1.3.10",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/test-utils": "^2.5.1",
    "fake-indexeddb": "^6.2.6",
    "happy-dom": "^21.0.3",
    "opentype.js": "^2.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.9.3",
    "vitest": "^5.0.4",
    "vue-tsc": "^3.3.13"
  }
}
