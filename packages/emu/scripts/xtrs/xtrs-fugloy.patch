+/*
+ * Fugloy (emu phase 7): the interrupt check z80_run makes after each
+ * instruction when not called with -1, as a function of its own, so a
+ * driver stepping with z80_run(-1) can take the response at the start of
+ * the next step.  last_instruction is the first byte of the instruction
+ * just run (z80_run's own test for EI and HALT).  mode 0 is z80_run's
+ * rule; 1 also takes a maskable interrupt with no request (IFF1 set);
+ * -1 takes no maskable interrupt.  Returns 2 for an NMI, 1 for a
+ * maskable interrupt, 0 for none.
+ */
+int z80_fugloy_interrupt(int last_instruction, int mode)
+{
+    if (z80_state.nmi && !z80_state.nmi_seen)
+    {
+        if (last_instruction == 0x76) {
+	    REG_PC++;
+	}
+        do_nmi();
+        z80_state.nmi_seen = TRUE;
+        if (trs_model == 1) {
+	  trs_reset_button_interrupt(0);
+	}
+	return 2;
+    }
+    if (mode >= 0 && z80_state.iff1 == 1 && last_instruction != 0xFB
+	&& (z80_state.irq || mode == 1))
+    {
+        if (last_instruction == 0x76) {
+	    REG_PC++;
+	}
+        do_int();
+	return 1;
+    }
+    return 0;
+}
+
 void z80_reset(void)
 {
     REG_PC = 0;
