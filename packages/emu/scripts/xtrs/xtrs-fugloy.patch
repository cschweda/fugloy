--- a/trs_interrupt.c
+++ b/trs_interrupt.c
@@ -277,6 +277,24 @@ trs_reset_button_interrupt(int state)
   if (!z80_state.nmi) z80_state.nmi_seen = 0;
 }
 
+/*
+ * Fugloy (emu phase 7): set the Model I's interrupt latch ($37E0) and
+ * the INT line it drives, and read it without acknowledging the timer.
+ */
+void
+trs_interrupt_latch_fugloy_set(int value)
+{
+  interrupt_latch = value & 0xff;
+  z80_state.irq = (trs_model == 1) ? (interrupt_latch != 0)
+    : ((interrupt_latch & interrupt_mask) != 0);
+}
+
+int
+trs_interrupt_latch_fugloy_peek(void)
+{
+  return interrupt_latch;
+}
