diff --git a/trs_keyboard.c b/trs_keyboard.c
index b2440df..9969248 100644
--- a/trs_keyboard.c
+++ b/trs_keyboard.c
@@ -905,6 +905,22 @@ static int kb_mem_value(int address)
     return data;
 }
 
+/*
+ * Fugloy (emu phase 7): set one key of the matrix at once, with no queue
+ * and no stretch, and read a matrix address without the side effects of
+ * trs_kb_mem_read.
+ */
+void trs_kb_fugloy_set(int row, int bit, int down)
+{
+    if (down) keystate[row & 7] |= (1 << (bit & 7));
+    else keystate[row & 7] &= ~(1 << (bit & 7));
+}
+
+int trs_kb_fugloy_peek(int address)
+{
+    return kb_mem_value(address);
+}
