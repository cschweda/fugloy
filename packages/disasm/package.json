{
  "name": "@fugloy/disasm",
  "version": "1.1.0",
  "description": "TRS-80 disassembler core: loaders, memory image, listing (no DOM, no Node)",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -b"
  },
  "dependencies": {
    "@fugloy/z80": "workspace:*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/cschweda/fugloy.git",
    "directory": "packages/disasm"
  },
  "homepage": "https://github.com/cschweda/fugloy#readme",
  "bugs": {
    "url": "https://github.com/cschweda/fugloy/issues"
  },
  "publishConfig": {
    "access": "public",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "default": "./dist/index.js"
      }
    }
  }
}
