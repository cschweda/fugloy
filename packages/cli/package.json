{
  "name": "@fugloy/cli",
  "version": "0.1.0",
  "description": "fugloy command-line disassembler",
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "source": "./src/index.ts",
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -b"
  },
  "bin": {
    "fugloy": "./bin/fugloy.js"
  },
  "dependencies": {
    "@fugloy/disasm": "workspace:*",
    "@fugloy/z80": "workspace:*"
  }
}
